# Copy this file to .env and fill in real values — never commit .env

# Vite app config
VITE_API_URL=http://localhost:8080

# Playwright test credentials — set these to real MongoDB Atlas accounts before running tests
TEST_BASE_URL=http://localhost:5173
TEST_EMPLOYEE_EMAIL=employee@your-domain.com
TEST_EMPLOYEE_PASSWORD=your_employee_password
TEST_MANAGER_EMAIL=manager@your-domain.com
TEST_MANAGER_PASSWORD=your_manager_password
TEST_HR_EMAIL=hradmin@your-domain.com
TEST_HR_PASSWORD=your_hr_password
TEST_NEW_USER_PASSWORD=your_new_user_password
